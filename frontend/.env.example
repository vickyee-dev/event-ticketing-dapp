# Chain the app talks to: 43113 = Avalanche Fuji (default), 43114 = Avalanche C-Chain, 31337 = local Hardhat node
VITE_CHAIN_ID=43113

# Optional. If empty, the address is read from src/contracts/deployments.json (written by the deploy script).
VITE_CONTRACT_ADDRESS=

# Optional. Override the read-only RPC endpoint for the chain above.
VITE_RPC_URL=
